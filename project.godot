; Engine configuration file.
; It's best to edit this file in the editor, not by hand.
config_version=5

[application]
config/name="Gallicus"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.6")

[gui]
theme/custom="res://ui/theme/official_theme.tres"

[autoload]
GameEvents="*res://scripts/systems/game_events.gd"
SaveManager="*res://scripts/systems/save_manager.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="viewport"
window/stretch/aspect="keep"

[input]
interact={"deadzone":0.5,"events":[{"type":"InputEventKey","keycode":69}]}
pause={"deadzone":0.5,"events":[{"type":"InputEventKey","keycode":16777217}]}

[internationalization]
locale/translations=PackedStringArray("res://assets/i18n/it.csv", "res://assets/i18n/en.csv")
