[sub_resource type="Shader" id="Shader_flag_cloth_wave"]
code = "shader_type canvas_item;\nuniform float amplitude = 2.0;\nuniform float speed = 1.2;\nuniform float frequency = 6.0;\n\nvoid vertex() {\n\tfloat wave = sin(UV.y * frequency + TIME * speed) * amplitude;\n\tVERTEX.x += wave;\n}"

[sub_resource type="Shader" id="Shader_menu_fog_layer"]
code = "shader_type canvas_item;\nuniform float speed = 0.02;\nuniform float strength = 0.05;\n\nvoid fragment() {\n\tvec2 uv = UV;\n\tuv.x += TIME * speed;\n\tuv.y += sin((UV.x + TIME) * 4.0) * strength;\n\tCOLOR = texture(TEXTURE, uv);\n}"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_flag_cloth_wave"]
shader = SubResource("Shader_flag_cloth_wave")
shader_parameter/amplitude = 2.0
shader_parameter/speed = 1.2
shader_parameter/frequency = 6.0

[sub_resource type="ShaderMaterial" id="ShaderMaterial_fog_back"]
