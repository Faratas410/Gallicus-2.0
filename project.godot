; Engine configuration file.
; It's best to edit this file in the editor, not by hand.
config_version=5

[application]
config/name="Gallicus"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.6")

[gui]
theme/custom="res://ui/theme/official_theme.tres"

[autoload]
GameEvents="*res://scripts/systems/game_events.gd"
SaveManager="*res://scripts/systems/save_manager.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="viewport"
window/stretch/aspect="keep"

[input]
move_up={"deadzone":0.5,"events":[{"type":"InputEventKey","keycode":87},{"type":"InputEventKey","keycode":16777232}]}
move_down={"deadzone":0.5,"events":[{"type":"InputEventKey","keycode":83},{"type":"InputEventKey","keycode":16777234}]}
move_left={"deadzone":0.5,"events":[{"type":"InputEventKey","keycode":65},{"type":"InputEventKey","keycode":16777231}]}
move_right={"deadzone":0.5,"events":[{"type":"InputEventKey","keycode":68},{"type":"InputEventKey","keycode":16777233}]}
attack_light={"deadzone":0.5,"events":[{"type":"InputEventKey","keycode":74}]}
attack_heavy={"deadzone":0.5,"events":[{"type":"InputEventKey","keycode":75}]}
block={"deadzone":0.5,"events":[{"type":"InputEventKey","keycode":76}]}
dodge={"deadzone":0.5,"events":[{"type":"InputEventKey","keycode":32}]}
interact={"deadzone":0.5,"events":[{"type":"InputEventKey","keycode":69}]}
